# Free local image generation works without this file. Copy it to .env only to
# enable the optional paid cloud generator or override local-helper settings.
# Never commit the real .env file. Keep any OpenAI key server-side.
OPENAI_API_KEY=

# Optional text-to-medal planner. The default is a cost-conscious Structured
# Outputs model; override it only with a model available to your API project.
OPENAI_MEDAL_MODEL=gpt-5-mini
OPENAI_MEDAL_TIMEOUT_MS=90000

# Free local generation needs no key. These optional values only change where
# MedalForge looks for the separately started loopback sd-server and how long a
# queued native job may run. Remote addresses are intentionally rejected.
MEDALFORGE_SD_URL=http://127.0.0.1:1234
MEDALFORGE_SD_TIMEOUT_MS=900000

# Optional no-cost local language-model enhancement for text-to-medal plans.
# It uses an already-running OpenAI-compatible local server; the instant
# deterministic planner remains available when this is blank or unavailable.
MEDALFORGE_LLM_URL=
MEDALFORGE_LLM_MODEL=Qwen3 local planner
MEDALFORGE_LLM_TIMEOUT_MS=12000
